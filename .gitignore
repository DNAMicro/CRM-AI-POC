# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# database — the working DB is local; only the demo snapshot is committed
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal
!data/demo.db
data/uploads/

# local AI-tooling state (sessions, screenshots, personal settings)
.playwright-mcp/
.superpowers/
.remember/
.claude/*
!.claude/skills/

# encryption key (auto-generated)
.encryption-key

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the template
!.env.example
