# Required — LLM access via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional — any OpenRouter model id (default: google/gemini-3.1-flash-lite-preview)
OPENROUTER_MODEL=

# Optional — key used to encrypt stored OAuth tokens. If unset, a random key
# is generated into .encryption-key on first run.
ENCRYPTION_SECRET=

# Optional — Gmail integration (Google Cloud OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Office 365 integration (Azure app registration)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
